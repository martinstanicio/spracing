# URL de conexión pooled de Neon PostgreSQL (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar sesiones de Better Auth (generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET="reemplazar-por-secreto-aleatorio-de-32-bytes"

# URL base pública de la aplicación
BETTER_AUTH_URL="http://localhost:3000"
